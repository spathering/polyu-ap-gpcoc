{
  "command": {
    "type": "object",
    "properties": {
      "protocolVersion": {
        "const": 1
      },
      "type": {
        "const": "command"
      },
      "requestId": {
        "type": "string",
        "maxLength": 100
      },
      "roomId": {
        "type": "string"
      },
      "payload": {
        "type": "object",
        "properties": {
          "commandId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "runId": {
            "type": "string"
          },
          "authorityEpoch": {
            "type": "string"
          },
          "catalogRevision": {
            "type": "string"
          },
          "rulesetRevision": {
            "type": "string"
          },
          "expectedViews": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "op": {
            "type": "string"
          },
          "args": {
            "type": "object"
          }
        },
        "required": [
          "commandId",
          "authorityEpoch",
          "op",
          "args"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "protocolVersion",
      "type",
      "requestId",
      "roomId",
      "payload"
    ],
    "additionalProperties": false
  },
  "login": {
    "type": "object",
    "properties": {
      "loginName": {
        "type": "string",
        "maxLength": 100
      },
      "password": {
        "type": "string",
        "maxLength": 200
      }
    },
    "required": [
      "loginName",
      "password"
    ],
    "additionalProperties": false
  },
  "receipt": {
    "type": "object",
    "properties": {
      "status": {
        "enum": [
          "unknown",
          "pending",
          "committed",
          "rejected"
        ]
      },
      "commandId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "result": {},
      "code": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "status",
      "commandId"
    ],
    "additionalProperties": false
  },
  "error": {
    "type": "object",
    "properties": {
      "code": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "code"
    ],
    "additionalProperties": false
  },
  "projection": {
    "type": "object",
    "properties": {
      "entities": {
        "type": "object"
      },
      "relations": {
        "type": "object"
      },
      "progress": {
        "type": "object"
      },
      "waits": {
        "type": "object"
      },
      "flows": {
        "type": "object"
      },
      "catalog": {
        "type": "object"
      },
      "roomId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "runId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "status": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "authorityEpoch": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "accountId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "role": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "authorizationEpoch": {
        "type": "integer",
        "minimum": 1
      },
      "chatChannels": {
        "type": "object"
      }
    },
    "required": [
      "entities",
      "relations",
      "progress",
      "waits",
      "flows",
      "catalog",
      "roomId",
      "name",
      "runId",
      "status",
      "authorityEpoch",
      "accountId",
      "role",
      "authorizationEpoch",
      "chatChannels"
    ],
    "additionalProperties": false
  },
  "chat.history": {
    "type": "object",
    "properties": {
      "channelId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "before": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [
      "channelId"
    ],
    "additionalProperties": false
  }
}
